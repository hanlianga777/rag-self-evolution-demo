+async function show(cycle:any){
+ const candidates=['A','B','C'].map(label=>({id:'candidate-'+label,status:'evaluated',config:{top_k:4},reasoning:{round:1,candidate_label:label},result:{qualification:{qualified:label==='A'}}}));
